{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "types": ["node"]
  },
  "include": [
    "src/locks/**/*.ts",
    "src/utils/bittyCrypto.ts",
    "src/utils/timeWindow.ts"
  ],
  "exclude": ["src/locks/__tests__/**/*.ts"]
}
